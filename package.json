{
  "name": "quillmate",
  "version": "0.0.1",
  "private": true,
  "description": "本地全自动 AI 小说工作台",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pw:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:real": "vitest run tests/real-model.test.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:rollback": "tsx scripts/db-rollback.ts"
  },
  "dependencies": {
    "next": "^16.4.6",
    "openai": "^6.49.0",
    "playwright": "^1.48.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}

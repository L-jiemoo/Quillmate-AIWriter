{
  "name": "quillmate",
  "version": "0.1.0",
  "private": true,
  "description": "本地全自动 AI 小说工作台",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pw:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:real": "vitest run tests/real-model.test.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:rollback": "tsx scripts/db-rollback.ts"
  },
  "dependencies": {
    "next": "^14.2.5",
    "openai": "^4.104.0",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}

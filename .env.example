# 不配置任何模型信息时，工作台自动使用 mock 模式（离线可跑通全流程）
# 推荐直接在浏览器右上角「模型设置」填写并保存；页面设置（data/settings.json）优先于本文件。

# 复制为 .env.local 后取消注释并填写：
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-your-key

# 可选微调
# LLM_TEMPERATURE=0.85
# 单次最大输出 Tokens，归一到 8192 / 16384 / 32768 三档；默认 16384
# LLM_MAX_TOKENS=16384
# 单次模型请求超时（毫秒），默认 180000
# LLM_TIMEOUT_MS=180000

# 单个后台任务最长运行时间（毫秒），默认 30 分钟
# QUILLMATE_JOB_TIMEOUT_MS=1800000

# 发布自动化使用的浏览器：默认复用系统 Edge（无需下载 Chromium）
# BROWSER_CHANNEL=msedge
# 改用 Playwright 自带 Chromium 时取消下一行并执行 npx playwright install chromium
# BROWSER_CHANNEL=chromium
